# Development database configuration (Infrastructure Checkpoint).
#
# Copy this file to .env.development.local (preferred - always ignored by
# git) or .env.development, fill in your real local values, and never
# commit the copy. Loaded automatically when NODE_ENV=development (see
# npm run dev:backend / npm run db:migrate:dev / npm run db:verify-env in
# package.json).
#
# This must point at a database that is NOT the Railway production
# database. If it resolves to the known production host or database
# name, every script that reads it (server, migration runner) will
# refuse to start - see config/database.js.

# Option A: a single connection URL (preferred - mirrors Railway's own
# MYSQL_URL convention).
DEV_DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/astrea_accounting_dev

# Option B: individual fields instead of a URL. Only used if
# DEV_DATABASE_URL above is not set.
# DEV_MYSQL_HOST=127.0.0.1
# DEV_MYSQL_PORT=3306
# DEV_MYSQL_USER=root
# DEV_MYSQL_PASSWORD=
# DEV_MYSQL_DATABASE=astrea_accounting_dev

# Everything below this line is unrelated to which database gets used -
# copied here only so a full .env.development.local has everything the
# app needs. Same values/meaning as backend/.env.example.
JWT_SECRET=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
AI_PROVIDER=mock