# Test database configuration (Infrastructure Checkpoint).
#
# Copy this file to .env.test.local (preferred - always ignored by git)
# or .env.test, fill in your real local values, and never commit the
# copy. Loaded automatically when NODE_ENV=test (see npm test / npm run
# test:integration / npm run db:migrate:test / npm run db:test:reset in
# package.json).
#
# Use a database SEPARATE from development, e.g. astrea_accounting_test
# vs. astrea_accounting_dev - `npm run db:test:reset` drops and recreates
# every table in this database on every run. It must never point at the
# same database as development, and it must NOT be the Railway
# production database - if it resolves to the known production host or
# database name, every script that reads it will refuse to start (see
# config/database.js).

# Option A: a single connection URL (preferred).
TEST_DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/astrea_accounting_test

# Option B: individual fields instead of a URL. Only used if
# TEST_DATABASE_URL above is not set.
# TEST_MYSQL_HOST=127.0.0.1
# TEST_MYSQL_PORT=3306
# TEST_MYSQL_USER=root
# TEST_MYSQL_PASSWORD=
# TEST_MYSQL_DATABASE=astrea_accounting_test

# Everything below this line is unrelated to which database gets used -
# copied here only so a full .env.test.local has everything the app
# needs. Same values/meaning as backend/.env.example.
JWT_SECRET=test-only-secret-not-for-production
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
AI_PROVIDER=mock